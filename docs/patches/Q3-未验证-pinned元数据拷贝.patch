     spec_batch_draft: bool = True
     #   True  = 同一候选位置把 B 条请求一起前向（k 次批量前向）
     #   False = 逐请求循环（B×k 次单序列前向）—— 消融 S1 的对照开关（= C 组行为）
+    spec_draft_pinned_meta: bool = True
+    #   True  = 草稿图每步的元数据（position / slot / ctx_len / block_table）
